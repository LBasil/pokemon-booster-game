# Client-side config (safe to expose - the anon key is designed to be public,
# access control is enforced by Postgres Row Level Security policies).
# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings > API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
